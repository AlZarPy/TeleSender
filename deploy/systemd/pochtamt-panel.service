[Unit]
Description=Pochtamt panel (SenderX web UI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=senderx
WorkingDirectory=/opt/senderx
EnvironmentFile=/opt/senderx/.env
Environment=SENDERX_CONFIG=/opt/senderx/config.txt
Environment=SENDERX_DB=/opt/senderx/panel.db
ExecStart=/opt/senderx/.venv/bin/python -m panel.app
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
