# Скопируйте в .env и поменяйте значения. Файл .env в git не попадает.

# Пароль панели «Почтамт». Обязателен, иначе панель не пустит (и не запустится).
PANEL_PASSWORD=смените-этот-пароль

# Порт панели (по умолчанию 8765)
# PANEL_PORT=8765

# Куда присылать сводку и тревоги. По умолчанию — «Избранное» вашего аккаунта.
# REPORT_CHAT=@username

# Путь к файлу аккаунтов и к базе (нужно только для Docker/нестандартной раскладки)
# SENDERX_CONFIG=/data/config.txt
# SENDERX_DB=/data/panel.db
